<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/motocare_road_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVoltarTrocaOleo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_icon"
                android:contentDescription="Voltar"
                android:padding="10dp"
                android:src="@drawable/ic_voltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="TROCA DE ÓLEO"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CARTÃO DE INFORMAÇÕES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_motocare"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registre a troca de óleo da sua motocicleta e acompanhe quando será necessário realizar a próxima."
                android:textColor="@color/white"
                android:textSize="15sp" />

        </LinearLayout>



        <!-- DATA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DATA DA TROCA"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelecionarData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/success"
            android:text="SELECIONAR DATA"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/txtDataSelecionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_action"
            android:padding="14dp"
            android:text="Nenhuma data selecionada"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- QUILOMETRAGEM -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="QUILOMETRAGEM ATUAL (KM)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtQuilometragem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_action"
            android:hint="Ex.: 12500"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="@color/white"
            android:textColorHint="#CCCCCC" />

        <!-- INTERVALO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="INTERVALO PARA A PRÓXIMA TROCA (KM)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtIntervaloKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_action"
            android:hint="Ex.: 1000"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="@color/white"
            android:textColorHint="#CCCCCC" />

        <!-- PREVISÃO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_motocare"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREVISÃO DA PRÓXIMA TROCA"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPrevisaoKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Próxima troca: -- km"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtPrevisaoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Previsão por tempo: --"
                android:textColor="@color/white"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- SALVAR -->
        <Button
            android:id="@+id/btnSalvarTrocaOleo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/success"
            android:text="SALVAR TROCA DE ÓLEO"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <!-- HISTÓRICO -->
        <Button
            android:id="@+id/btnVerHistoricoOleo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/success"
            android:text="VER HISTÓRICO DE TROCAS"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- ESPAÇO EXTRA PARA ROLAR COM O TECLADO ABERTO -->
        <View
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:importantForAccessibility="no" />

    </LinearLayout>

</ScrollView>
