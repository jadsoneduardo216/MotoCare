<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/motocare_road_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVoltarHistoricoOleo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_icon"
                android:contentDescription="Voltar"
                android:padding="10dp"
                android:src="@drawable/ic_voltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="HISTÓRICO DE TROCAS DE ÓLEO"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- IDENTIFICAÇÃO DA MOTO -->
        <TextView
            android:id="@+id/txtKmAtual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_motocare"
            android:padding="16dp"
            android:text="Quilometragem atual: -- km"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- SITUAÇÃO ATUAL -->
        <TextView
            android:id="@+id/txtSituacaoAtual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_action"
            android:padding="16dp"
            android:text="Situação da troca de óleo"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- TÍTULO DA LISTA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="REGISTROS ANTERIORES"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- MENSAGEM SEM REGISTROS -->
        <TextView
            android:id="@+id/txtHistoricoVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_action"
            android:gravity="center"
            android:padding="20dp"
            android:text="Nenhuma troca de óleo registrada para esta motocicleta."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- LISTA DE TROCAS -->
        <LinearLayout
            android:id="@+id/containerHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- ESPAÇO INFERIOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:importantForAccessibility="no" />

    </LinearLayout>

</ScrollView>
